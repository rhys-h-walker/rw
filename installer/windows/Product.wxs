<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode must never change: it is how newer MSIs find and replace older installs. -->
  <Package Name="rw"
           Manufacturer="Rhys Walker"
           Version="$(Version)"
           UpgradeCode="329FC5E3-3980-4273-BB2A-9DCB42717E89"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of rw is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="rw" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="RwComponents" Directory="INSTALLFOLDER">
      <Component Id="RwExe" Guid="E18EAC76-52CA-4795-94B4-3A01DB8530B0">
        <File Id="RwExeFile" Source="$(PayloadDir)\rw.exe" />
        <!-- Per-user components need an HKCU key path (ICE38). -->
        <RegistryValue Root="HKCU" Key="Software\rw" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="RwPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="no" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="rw" Level="1">
      <ComponentGroupRef Id="RwComponents" />
    </Feature>
  </Package>
</Wix>
